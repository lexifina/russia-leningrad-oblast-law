=50acf12d-2461-466e-bada-de5d8b7737a1&DocumentTypes=1ee8f2cc-d23f-4ac1-a0e4-1fd202ecc736&DocumentTypes=5cf51861-5b6f-4210-9776-8086c05fdc8b&DocumentTypes=cdafe085-10fe-4199-92a5-9aa82b2b6c99&DocumentTypes=bdfe8274-cfc2-4a62-b413-91a201646ced&DocumentTypes=8910e61f-371d-490c-a1b8-aa7b8a5a48be&DocumentTypes=e880fa45-e4f4-4db9-bba0-847666adebab&DocumentTypes=16b9a101-4ce2-47d0-8a92-8b1aff72867a&PageSize=200&Index=9&SortedBy=5&SortDestination=asc"}, {"at": "2026-11-24T14:12:13Z", "bytes": 6145, "method": "GET", "status": 200, "url": "http://publication.pravo.gov.ru/api/Document?eoNumber=4700202410100001"}, {"at": "2026-11-24T14:12:17Z", "bytes": 1722, "method": "GET", "status": 200, "url": "http://publication.pravo.gov.ru/api/Document?eoNumber=4700201704110007"}], "runner": "lawwatch russia (65e3dde363)", "schema": "lexifina-check/1", "seen": {"added": ["4700202611120001", "4700202611120002", "4700202611120003", "4700202611120004", "4700202611120005", "4700202611120006", "4700202611120007", "4700202611120008", "4700202611120009", "4700202611120010", "4700202611120011", "4700202611120012", "4700202611120013", "4700202611120014", "4700202611120015", "4700202611120016", "4700202611120017", "4700202611120018"], "changed": [], "removed": []}, "snapshot": "1788 law-type documents in block region47; newest published 2026-11-12", "source": "pravo-leningrad-oblast", "started": "2026-11-24T14:09:23Z", "titles": {"4700202611120001": "О внесении изменений в областной закон \"О мировых судьях Ленинградской области\"", "4700202611120002": "О внесении изменений в статью 3 областного закона \"О дополнительных гарантиях социальной поддержки детей-сирот и детей, оставшихся без попечения родителей, лиц ", "4700202611120003": "О внесении изменений в областной закон \"Об областном бюджете Ленинградской области на 2026 год и на плановый период 2027 и 2028 годов\"", "4700202611120004": "Об упразднении населенного пункта – кордона Верхние Сютти Лисинского сельского поселения Тосненского муниципального района Ленинградской области и о внесении из", "4700202611120005": "О внесении изменения в статью 7-1 областного закона \"О развитии малого и среднего предпринимательства на территории Ленинградской области\"", "4700202611120006": "О внесении изменения в статью 3 областного закона \"О критериях, которым должны соответствовать объекты социально-культурного и коммунально-бытового назначения, ", "4700202611120007": "Об изменении вида населенного пункта Аннино в Ломоносовском муниципальном районе Ленинградской области и о внесении изменения в областной закон \"Об администрати", "4700202611120008": "О внесении изменения в статью 1 областного закона \"О регулировании отдельных вопросов в сфере лесных отношений в Ленинградской области\"", "4700202611120009": "О внесении изменений в областной закон \"О наделении органов местного самоуправления муниципальных образований Ленинградской области отдельными государственными ", "4700202611120010": "О внесении изменений в статью 5-1 областного закона \"О развитии туризма в Ленинградской области и о признании утратившими силу некоторых областных законов и отд", "4700202611120011": "О внесении изменения в статью 3 областного закона \"Об отдельных мерах стимулирования в сфере промышленности Ленинградской области и о внесении изменений в отдел", "4700202611120012": "О внесении изменений в статьи 2 и 5 областного закона \"Об обеспечении реализации полномочий органов государственной власти Ленинградской области в области произ", "4700202611120013": "О внесении изменений в некоторые областные законы", "4700202611120014": "О внесении изменений в областной закон \"О защите населения и территорий Ленинградской области от чрезвычайных ситуаций природного и техногенного характера\"", "4700202611120015": "О внесении изменений в статью 2 областного закона \"О социальном обслуживании граждан в Ленинградской области\"", "4700202611120016": "О внесении изменений в областной закон \"Об установлении ставки налога, взимаемого в связи с применением упрощенной системы налогообложения, на территории Ленинг", "4700202611120017": "О внесении изменений в областной закон \"О бесплатном предоставлении отдельным категориям граждан земельных участков на территории Ленинградской области\" и стать", "4700202611120018": "О внесении изменений в областной закон \"Об охране здоровья населения Ленинградской области\""}, "unexplained": 0, "update": {"append": {"commits": 1, "corrections": null, "extended_acts": ["zakony-2026"], "new_acts": []}, "parts": ["95-watch-20261124-001.json"]}, "verify": {"cycle_days": 1, "examples": [], "held": 13, "method": "the portal's whole listing for the subject (read this check, every page) parsed by the builder (ru_catalogue.parse) and compared, publication day by publication day, with the corpus this repository is built from; each year's newest state rendered by the builder (gitlaw_common) against the files at the tip of main", "ok": true, "swept": 13, "versions_checked": 393, "versions_differ": 0}}
